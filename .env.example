# ==============================================================================
# PICC-PP-Admin-Portal-Frontend - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' or '.env.local' and populate with your environment-specific values.
# Do NOT commit '.env' or real production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Base Path Configuration
# ------------------------------------------------------------------------------
# Port for local dev server or container runtime (Default: 8080 / 5173 for Vite)
PORT=8080

# Base URL path where the frontend is served (Default: /nnp-admin/)
VITE_BASE_URL=/nnp-admin/

# ------------------------------------------------------------------------------
# 2. Platform Core Services & Ingress Gateways
# ------------------------------------------------------------------------------
# Base domain URL for platform services
VITE_DOMAIN=http://localhost:3000

# Platform Authentication Gateway URL (Keycloak / Auth service)
VITE_AUTH=http://localhost:3000/nnp
VITE_AUTH_HOST=http://localhost:3000/nnp

# User Dashboard Host URL
VITE_DASH=http://localhost:3000/nnpdash
VITE_DASH_HOST=http://localhost:3000/nnpdash

# Admin Configuration Service Endpoints
VITE_ADMIN_POTAL=http://localhost:3000/nnpconf
VITE_NNP_CONFT=http://localhost:3000/nnpconf
VITE_NNP_CONFT_PUB=http://localhost:3000/nnpconf-pub

# ------------------------------------------------------------------------------
# 3. Microservice API Endpoints
# ------------------------------------------------------------------------------
# Environment Management Microservice API
VITE_API_ENVIRONMENT_MANAGEMENT_URL=/nnpconf/env

# User Access & RBAC Microservice API
VITE_API_USER_ACCESS_URL=/nnpconf/user

# Document Management Service (DMS) API
VITE_API_DMS_MANAGEMENT_URL=/dms-management-service/api/dms

# HAProxy Integration Microservice API (PICC-PC-Haproxy-Integration)
VITE_API_CONFIG_URL=http://localhost:8081

# Platform Support Service URL
VITE_SUPPORT_URL=http://localhost:3000/nnpdash/support

# Issue Tracker / Redmine Integration URL
VITE_REDMINE_URL=https://redmine.example.com

# ------------------------------------------------------------------------------
# 4. Session & Cookie Policy
# ------------------------------------------------------------------------------
# Cookie domain scope (e.g., .localhost for dev, .example.com for production)
VITE_COOKIE_DOMAIN=.localhost

# Production Mode Flag (true / false)
PRODUCTION=false
